{
  "name": "@sanguosha/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "tsx watch src/local-dev.ts",
    "build": "tsc -p tsconfig.json",
    "start:local": "node dist/local-dev.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
