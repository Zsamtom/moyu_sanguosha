# Docker Compose uses this value both to initialize PostgreSQL and to build
# DATABASE_URL. Keep production values URL-safe (letters, digits, `_`, `-`).
POSTGRES_PASSWORD=replace-with-a-url-safe-random-value

PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://sanguosha:sanguosha@localhost:5433/sanguosha
SESSION_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-before-production
INITIAL_ADMIN_DISPLAY_NAME=管理员
APP_ORIGIN=http://localhost:5173

# Public, non-secret release metadata exposed by GET /version.
APP_VERSION=dev
BUILD_SHA=

# Optional bootstrap values for hybrid Dou Dizhu bots. Prefer configuring
# DeepSeek V4 Flash from the Web administrator page. Leave all three primary
# values empty to keep it disabled until an administrator saves settings.
DOUDIZHU_LLM_ENDPOINT=
DOUDIZHU_LLM_API_KEY=
DOUDIZHU_LLM_MODEL=
DOUDIZHU_LLM_TIMEOUT_MS=10000
DOUDIZHU_LLM_MAX_OUTPUT_TOKENS=4000
