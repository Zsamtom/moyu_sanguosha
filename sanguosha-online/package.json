{
  "name": "sanguosha-online",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @sanguosha/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "e2e": "pnpm build && playwright test",
    "e2e:ci": "playwright test",
    "deploy:prod": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-production.ps1",
    "deploy:prod:check": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-production.ps1 -PreflightOnly"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
